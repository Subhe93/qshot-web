        "layout_type": "cards",
        "reviews": [
          {
            "id": "20260720-1649-8426-b874-567ff896cde7",
            "reviewer_name": "Ignacio Kindelán",
            "reviewer_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjXTGeiqAb6eqISLSKPcpDgX1Eolca-GXoZ3r4LAQ8mZTYVzeicpBQ=s128-c0x00000000-cc-rp-mo-ba4",
            "rating": 5,
            "text": "The best event in Dubai, part of the Gitex, but very focused in AI and investors.",
            "relative_time_description": "9 months ago",
            "hidden": false,
            "locked": true,
            "google_review_key": "Ignacio Kindelán_1760770241"
          },
          {
            "id": "20260720-1649-8326-8874-ef2a8c32b295",
            "reviewer_name": "jignesh darji",
            "reviewer_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjURc9YArn0J3ZfI50G7sPBWpM2IiaPBHz0ry5mHhqOeIpJMDuYAlg=s128-c0x00000000-cc-rp-mo-ba5",
            "rating": 4,
            "text": "Very good event for startup and seed funding. Lots of companies are participating from across the world. Definately worth visiting. Staff is helpful all across. Don't wait for cab after 5 pm.",
            "relative_time_description": "a year ago",
            "hidden": false,
            "locked": true,
            "google_review_key": "jignesh darji_1728934308"
          },
          {
            "id": "20260720-1649-8c26-9874-2ff8452f2e73",
            "reviewer_name": "Shoaib Sayyed",
            "reviewer_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjU5zL2w8RQUZR0d3C9di99IrQP4Ha643Wu7va3p4ZnjKr4CKKdEow=s128-c0x00000000-cc-rp-mo-ba5",
            "rating": 5,
            "text": "Amazing place to do the event. Loved the vibe here.",
            "relative_time_description": "9 months ago",
            "hidden": false,
            "locked": true,
            "google_review_key": "Shoaib Sayyed_1760947795"
          },
          {
            "id": "20260720-1649-8226-b874-8ed03e7047e8",
            "reviewer_name": "Huda Imran",
            "reviewer_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocKil_dbRSO1GNUQr2QNUA7SEJtyouM6_EI08-o1vZUb6Ho92QjA=s128-c0x00000000-cc-rp-mo-ba3",
            "rating": 5,
            "text": "Amazing experience. Although getting there is an experience of its own, planning the trip there was fun. The views of the Harbour and SkyDive and Dubai were absolutely breathtaking.",
            "relative_time_description": "a year ago",
            "hidden": false,
            "locked": true,
            "google_review_key": "Huda Imran_1729097801"
          },
          {
            "id": "20260720-1650-8f05-a226-be9d6b857e84",
            "reviewer_name": "Akhtar Edroos",
            "reviewer_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocLvEUBjOs6Ah_YgDysN7o-qM4thHPpHl-c2WPWsGkhgf3oIAqbz=s128-c0x00000000-cc-rp-mo-ba4",
            "rating": 3,
            "text": "Great place for investors who are looking to invest in new companies and emerging tech. Could've been organized / managed better as the parking to the venue was always either full or reserved. The event this year was massive, took a while to cover. Not possible to see it all and have meaningful conversations with the parties you're interested in, within a day. If you plan to go, keep at least 3 days aside, just for this event.",
            "relative_time_description": "a year ago",
            "hidden": false,
            "locked": false,
            "google_review_key": null
          }
        ],
