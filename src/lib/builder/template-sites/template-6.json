      {
        "type": "HeaderModule",
        "id": "20260428-1111-8013-a612-3778e7ae2b34",
        "background_color": null,
        "use_background_color": false,
        "hide": false,
        "value": "Introduction",
        "align": "start",
        "size": 22
      },
      {
        "type": "ParagraphModule",
        "id": "20260428-1105-8408-9093-8da24c29e4c7",
        "background_color": null,
        "use_background_color": false,
        "hide": false,
        "content": "[{\"insert\":\"In the heart of the \"},{\"insert\":\"North Rhine\",\"attributes\":{\"bold\":true}},{\"insert\":\" in \"},{\"insert\":\"Bochum\",\"attributes\":{\"bold\":true}},{\"insert\":\", where wood whispers in the light and reveals its secrets to the laser beam, \"},{\"insert\":\"Kunsiva\",\"attributes\":{\"bold\":true}},{\"insert\":\" was born.\\n\\nHere we see no wood, but we bring the warmth of its soul to life.\\n\\nWe do not cut into it, but we weave a memory into it, from a mural that embraces your wall to a wooden shield that preserves the glory of your moments, from a radiant name that adorns the facade of your dream to a reality where time and space are complete, woven for you in light and shadow.\\n\\nWe laser engrave stories and narratives that time cannot erase.\\n\"}]"
      },
